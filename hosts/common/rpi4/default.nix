# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  inputs,
  ...
}:
{
  imports = [
    inputs.nixos-hardware.nixosModules.raspberry-pi-4
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  nixpkgs.system = "aarch64-linux";

  boot = {
    tmp.useTmpfs = true;
    # initrd = {
    #   availableKernelModules = [ "usbhid" "usb_storage" ];
    #   kernelModules = [ ];
    # };
    # extraModulePackages = [ ];
    # kernelPackages = lib.mkForce pkgs.linuxPackages_rpi4;
    kernelParams = [
      "8250.nr_uarts=1"
      "console=ttyAMA0,115200"
      "console=tty1"
      # Some gui programs need this
      "cma=128M"
    ];
  };
  # ブートローダは nixos-hardware 既定の U-Boot + extlinux。
  # `hardware.raspberry-pi.firmware.uboot.enable` は useGenerationDeviceTree を
  # mkDefault false にするが、従来どおりカーネル同梱 DTB + apply-overlays-dtmerge
  # (extlinux.conf の FDTDIR) を使い続けるため明示的に true にする。
  # 詳細: docs/rpi4-uboot-firmware.md
  boot.loader.generic-extlinux-compatible.useGenerationDeviceTree = true;

  # sd-image.nix は [ nofail noauto ] だが、firmware の activation script は
  # マウント済みでないとスキップするので常時マウントする。
  fileSystems."/boot/firmware".options = lib.mkForce [
    "nofail"
    "noatime"
  ];

  # NetworkManager は networking.enableIPv6 = false (sysctl all/default の
  # disable_ipv6 = 1) でも、自動生成する有線プロファイルの ipv6.method = auto で
  # end0 だけ disable_ipv6 = 0 に戻し、グローバル IPv6 が付いてしまう。
  # その結果 avahi が AAAA を配り、IPv6 優先のクライアント (iPad の Infuse 等) が
  # IPv4 にしか待受していない smbd へ IPv6 で繋ぎに行って失敗する。さらに
  # IPv6 無効前提で ip6tables の firewall が無いため IPv6 側が無防備になる。
  # 有線プロファイルを宣言して IPv6 を明示的に無効化する。
  networking.networkmanager.ensureProfiles.profiles.end0 =
    lib.mkIf config.networking.networkmanager.enable
      {
        connection = {
          id = "end0";
          type = "ethernet";
          interface-name = "end0";
          autoconnect = true;
          autoconnect-priority = 10;
        };
        ipv4.method = "auto";
        ipv6.method = "disabled";
      };
  # 自動生成の "Wired connection 1" が有効なままなら宣言したプロファイルへ切り替える
  # (ensure-profiles は reload までしか行わない)
  systemd.services.NetworkManager-ensure-profiles.script = lib.mkIf config.networking.networkmanager.enable (
    lib.mkAfter ''
      if [ "$(${pkgs.networkmanager}/bin/nmcli -g GENERAL.CONNECTION device show end0 2>/dev/null)" != "end0" ]; then
        ${pkgs.networkmanager}/bin/nmcli connection up end0 || true
      fi
    ''
  );

  # Required for the Wireless firmware
  hardware.enableRedistributableFirmware = true;
  hardware = {
    raspberry-pi = {
      "4".apply-overlays-dtmerge.enable = true;

      # switch ごとに /boot/firmware (start4.elf, DTB, config.txt, u-boot.bin) を
      # 再配置する。SD イメージ作成時の U-Boot (2021.04) は 44MB 超のカーネルを
      # 扱えず起動不能になったため、nixpkgs の U-Boot (2026.04, 84MB まで対応)
      # に追従させる。
      firmware = {
        enable = true;
        uboot.enable = true;
      };

      configtxt = {
        settings = {
          # mainline カーネルの framebuffer を firmware の警告表示で壊さない
          all.avoid_warnings = true;
          # GIC-400 経由で割り込みを配送する (U-Boot 用。armstub8-gic.bin は不要)
          pi4.enable_gic = true;
        };
        # ヘッドレスかつ FDTDIR で DTB を再ロードするため firmware 側 overlay は不要
        deviceTreeOverlays.all = lib.mkForce [ ];
      };
    };
    deviceTree = {
      enable = true;
      filter = "*rpi-4-*.dtb";
    };
  };

  # fileSystems."/" = {
  #   device = "/dev/disk/by-label/NIXOS_SD";
  #   fsType = "ext4";
  # };

  swapDevices = [ ];

  powerManagement.cpuFreqGovernor = lib.mkDefault "ondemand";
}
