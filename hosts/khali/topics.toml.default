# Hermes daily-podcast — トピック定義
# このファイルは hermes-daily-podcast-seed.service が初回のみ
# /var/lib/hermes-podcast/topics.toml にコピーする。以降は hermes の
# `add_topic` ツール (Discord 等の対話から) か手編集で更新する。Nix 側は触らない。
#
# VOICEVOX speaker_id (主要):
#   2  = 四国めたん ノーマル (default)
#   3  = ずんだもん ノーマル
#   8  = 春日部つむぎ ノーマル

[[topic]]
slug = "hobby-models"
title = "ホビー模型 Tips"
description = """\
プラモデル・ガンプラ・フィギュア・ジオラマ・スケールモデルなどの「組み立て・塗装・改造・ \
レビュー・新製品情報」を扱う。一般芸能 / スポーツ / 政治 / 一般 IT ニュース・社会問題は \
完全に対象外。AI / LLM / ChatGPT 系の話題も対象外。\
"""
voicevox_speaker_id = 2
target_segment_count = 5

# はてブはタグ検索で絞る (キーワード/カテゴリよりノイズが少ない)。
# タグは LLM が会話の文脈から推測して `add_topic` で渡してもよい。
# 注意: `hobby` タグは「趣味一般」のバズ記事 (ジャンル外) が大量に混ざるので使わない。
# min_users = 1 で広く拾い、ジャンル・品質の選別は LLM 採点に任せる。
# date_begin は handlers が「前回生成日 − 2 日」を自動注入する (明示指定で上書き可)。
[[topic.sources]]
type = "hatena"
tags = ["模型", "プラモデル", "ガンプラ", "フィギュア", "スケールモデル", "ジオラマ", "ミニ四駆", "エアブラシ"]
min_users = 1

[[topic.sources]]
type = "hackernews"
query = "\"plastic model\" OR \"scale model\" OR \"plamodel\" OR \"diorama painting\""
min_points = 5
min_comments = 1

[[topic.sources]]
type = "reddit"
subreddit = "Gunpla"
timeframe = "day"
min_score = 30

[[topic.sources]]
type = "reddit"
subreddit = "modelmakers"
timeframe = "day"
min_score = 20

[[topic.sources]]
type = "reddit"
subreddit = "ScaleModelKits"
timeframe = "day"
min_score = 15

# ──────────────────────────────────────────────────────────────────────────
# 新ソース type (github_issues / polymarket / youtube / x) のサンプル。
# `add_topic` ツールで topic を新しく作るときの叩き台として残してある。
# このファイル自体は seed 用なので、編集する場合は
# /var/lib/hermes-podcast/topics.toml を直接いじる方が安全。
# ──────────────────────────────────────────────────────────────────────────
#
# [[topic]]
# slug = "oss-tech"
# title = "OSS / 技術トピック"
# description = "OSS の議論・新リリース・予測市場・YouTube 解説などを横断的に拾う"
# voicevox_speaker_id = 3  # ずんだもん ノーマル
# target_segment_count = 5
#
# # GitHub Issues / PR: 認証は GITHUB_TOKEN env (agenix daily-podcast-env.age)
# # 検索構文は GitHub Search の構文がそのまま使える
# [[topic.sources]]
# type = "github_issues"
# query = "kubernetes label:enhancement"
# min_reactions = 10
# since_days = 7
#
# # Polymarket: 鍵不要。アクティブな予測市場のみ surface
# [[topic.sources]]
# type = "polymarket"
# query = "AI safety"
# limit = 10
#
# # YouTube: pkgs.yt-dlp バイナリが PATH に必要 (hermes-agent.nix で同梱済み)
# [[topic.sources]]
# type = "youtube"
# query = "claude code workflow"
# limit = 8
# lang = "ja"
#
# # X (xAI Live Search): XAI_API_KEY env が必要 (agenix daily-podcast-env.age)
# [[topic.sources]]
# type = "x"
# query = "Anthropic Claude"
# limit = 12
# lang = "ja"
